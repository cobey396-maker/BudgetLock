# Copy to .env and fill in. (Vercel injects the two POSTGRES_* vars for you
# when you attach a Postgres store, so you don't set those in Vercel by hand.)

POSTGRES_PRISMA_URL=""        # pooled Postgres connection (runtime)
POSTGRES_URL_NON_POOLING=""   # direct Postgres connection (schema push)

AUTH_SECRET=""                # long random string: openssl rand -hex 32

PLAID_CLIENT_ID=""            # Plaid dashboard → Keys (optional; blank = mock)
PLAID_SECRET=""               # Plaid Sandbox secret
PLAID_ENV="sandbox"
