# Copy to .env and fill in.
#
# On Vercel, attaching a Postgres store injects the two POSTGRES_* vars for you,
# so you never type those by hand. Everything else you set under
# Project → Settings → Environment Variables.

# ── Database (required) ──────────────────────────────────────────────────────
POSTGRES_PRISMA_URL=""        # pooled Postgres connection (runtime)
POSTGRES_URL_NON_POOLING=""   # direct Postgres connection (migrations)

# ── Secrets (required) ───────────────────────────────────────────────────────
# Backs session tokens and the encryption of stored Plaid access tokens.
# Generate with: openssl rand -hex 32
# Rotating this signs everyone out and invalidates existing bank connections.
AUTH_SECRET=""

# ── Plaid (optional — leave blank to use the built-in mock importer) ─────────
PLAID_CLIENT_ID=""            # Plaid dashboard → Keys
PLAID_SECRET=""               # secret matching PLAID_ENV
PLAID_ENV="sandbox"           # sandbox | production

# ── Public app config ────────────────────────────────────────────────────────
# Canonical origin, used for metadata, Open Graph and the sitemap. On Vercel
# this is inferred from VERCEL_PROJECT_PRODUCTION_URL if you leave it unset.
NEXT_PUBLIC_APP_URL=""

# Shown on the privacy policy and terms pages. Fill these in before launch.
NEXT_PUBLIC_OPERATOR_NAME=""  # e.g. "Acme Software LLC"
NEXT_PUBLIC_CONTACT_EMAIL=""  # e.g. "support@budgetlock.app"
NEXT_PUBLIC_GOVERNING_LAW=""  # e.g. "the State of California, United States"
NEXT_PUBLIC_LEGAL_UPDATED=""  # e.g. "5 September 2026"
